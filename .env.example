# Database (overridden by docker-compose for the api service)
DATABASE_URL=postgresql+psycopg://memory:memory@localhost:5432/memory_graph

# Optional: protect API when hosted (leave empty for local open access)
API_KEY=

# LLM via LiteLLM — swap provider by changing model + key + base URL
# Examples:
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=anthropic/claude-3-5-sonnet-latest
#   LLM_MODEL=xai/grok-2-latest
#   LLM_MODEL=ollama/llama3.2
#   LLM_API_BASE=http://host.docker.internal:11434  (for Ollama)
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=

EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_DIM=1536

# Speech-to-text (OpenAI-compatible Whisper)
STT_MODEL=openai/whisper-1
STT_API_KEY=
STT_API_BASE=

# Text-to-speech (Grok / xAI)
TTS_PROVIDER=grok
TTS_API_KEY=
TTS_API_BASE=https://api.x.ai/v1
TTS_MODEL=grok-tts
