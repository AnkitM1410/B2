# Database (overridden by docker-compose for the api service)
DATABASE_URL=postgresql+psycopg://memory:memory@localhost:5432/memory_graph

# Optional: protect API when hosted (leave empty for local open access)
API_KEY=

# LLM via LiteLLM — using Groq (get key at console.groq.com)
# Other options:
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=anthropic/claude-3-5-sonnet-latest
#   LLM_MODEL=ollama/llama3.2
#   LLM_API_BASE=http://host.docker.internal:11434  (for Ollama)
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_API_KEY=
LLM_API_BASE=

EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_DIM=1536

# Speech-to-text — Groq Whisper (fastest, free tier available)
# Alternative: openai/whisper-1  with STT_API_BASE=
STT_MODEL=groq/whisper-large-v3-turbo
STT_API_KEY=
STT_API_BASE=

# Text-to-speech — Groq PlayAI TTS
# Voices: Fritz-PlayAI, Celeste-PlayAI, Chip-PlayAI, etc.
# See https://console.groq.com/docs/text-speech for full list
TTS_PROVIDER=groq
TTS_API_KEY=
TTS_API_BASE=https://api.groq.com/openai/v1
TTS_MODEL=playai-tts
